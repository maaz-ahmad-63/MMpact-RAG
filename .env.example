# ---------------------------------------------------------------------------
# FastAPI AI Agent Service
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Write the log to a file as well as stdout. Blank = stdout only.
# docker-compose sets this to /app/logs, bind-mounted to ./logs on the host, so
# the log survives the json-file driver's 10 MB x 5 cap - which a busy number
# burns through in hours, taking the morning you need with it.
LOG_DIR=
LOG_FILE_NAME=ai-agent.log
LOG_FILE_MAX_MB=20
LOG_FILE_KEEP=10


# Shared secret every caller must send (the gateway, or any client app calling
# this service directly). Header: Authorization: Bearer <value>
AGENT_API_TOKEN=change-me-agent-token

# ---------------------------------------------------------------------------
# Persistence: threads and prompt records, as JSON files. No database.
# ---------------------------------------------------------------------------
DATA_DIR=./storage
# Turns retained per thread - working memory for the model, not an archive.
THREAD_MAX_TURNS=40

# ---------------------------------------------------------------------------
# Provider selection: groq (default) | anthropic
# ---------------------------------------------------------------------------
MAX_TOKENS=2000
MAX_TOOL_ITERATIONS=4

# OVERRIDES / EXTENDS the built-in alias table (services/models.py).
# gemini_3_flash, gemini_3_pro, gemini_2_5_flash etc. already work with
# no configuration - only set this to remap them or add your own.
# Translates a client's model vocabulary into real model ids:
#   alias=provider:model,alias2=provider:model
# A model a client names but that is NOT mapped here is refused with 422 -
# never silently answered on the default model.

# What to do when a client asks for a model that is not in the alias table.
#   refuse  (default) 422, no reply - never answers on a model nobody chose
#   infer             read the vendor off the name ("groq_llama_3_3" -> Groq)
#                     and use that provider's default. Keeps a dashboard model
#                     change from silently taking WhatsApp down.
#   default           always fall back to the service default model


# -- Groq -------------------------------------------------------------------
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
GROQ_TEMPERATURE=0.3
# Only accepted by some Groq models (e.g. gpt-oss). Leave empty to omit.
GROQ_REASONING_EFFORT=

# -- Google Gemini (only used when a model resolves to the gemini provider) --
# GEMINI_API_KEY is Google's own name for it; GOOGLE_API_KEY works too.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEMPERATURE=0.3
# Gemini 3.x always reasons first, and those tokens count against MAX_TOKENS.
# A small budget keeps short replies from being truncated. -1 = model decides.
# 0 is rejected by Gemini 3 - reasoning cannot be turned off on those models.
GEMINI_THINKING_BUDGET=128

# -- Anthropic (used when a text_llm resolves to Anthropic) ----------------------
ANTHROPIC_API_KEY=
# adaptive | disabled
THINKING_MODE=adaptive
# low | medium | high | xhigh | max
EFFORT=low

# ---------------------------------------------------------------------------
# Laravel back-channel (read-only, used by tools)
# NO ROUTE IS ASSUMED. A tool is only offered to the model once its endpoint is
# configured. Leave both blank to run the agent with no tools at all.
# A value may be a path (joined onto LARAVEL_BASE_URL) or a full URL.
# {id} is replaced with the whatsapp_id.
# ---------------------------------------------------------------------------
LARAVEL_BASE_URL=
LARAVEL_API_TOKEN=
LARAVEL_TIMEOUT_S=10

# GET - products, pricing, policies, hours, FAQ.
KNOWLEDGE_API=/api/whatsapp/{id}/knowledge

# POST - escalate a conversation to a human agent.
HANDOFF_API=/api/whatsapp/{id}/handoff

ENABLE_KNOWLEDGE_TOOL=true
ENABLE_HANDOFF_TOOL=true

# Knowledge-base search. false stops the agent OFFERING rag_search on both
# /agent/reply and /api/v1/agent/chat - replies then come from the prompt, the
# conversation and the caller's context alone. The /api/rag/* routes are NOT
# affected: you can still upload documents and call POST /api/rag/search, so a
# corpus can be ingested and tested before the agent is allowed to use it.
# To disable the whole RAG layer instead, leave RAG_DATABASE_URL unset.
ENABLE_RAG_TOOL=true

# ---------------------------------------------------------------------------
# OpenClaw Gateway back-channel - powers the block_contact / unblock_contact
# tools. This is the ONLY route from the agent to WhatsApp, and it goes through
# the gateway's REST API: never Baileys, never a client app's own API.
# Blank = those tools are not offered to the model.
# ---------------------------------------------------------------------------
GATEWAY_BASE_URL=http://127.0.0.1:3000
GATEWAY_TOKEN=change-me-gateway-token
GATEWAY_TIMEOUT_S=10
ENABLE_BLOCK_TOOLS=true

# ---------------------------------------------------------------------------
# OpenClaw integration (this service acts as an OpenAI-compatible provider)
# OpenClaw cannot carry client_id/prompt_id through the OpenAI schema, so they
# are set here. One of OPENCLAW_PROMPT / OPENCLAW_PROMPT_ID is REQUIRED for
# /v1/chat/completions - this service ships no default prompt.
# ---------------------------------------------------------------------------
OPENAI_COMPAT_MODEL_NAME=whatsapp-agent
OPENCLAW_CLIENT_ID=openclaw
# Inline instruction text …
OPENCLAW_PROMPT=
# … or the id of a prompt registered via POST /agent/prompt under the client_id above.
OPENCLAW_PROMPT_ID=

# ---------------------------------------------------------------------------
# Reply shaping defaults (a client can override per request via context.ai_settings)
# ---------------------------------------------------------------------------
DEFAULT_MAX_WORDS=120
FALLBACK_REPLY=

# ---------------------------------------------------------------------------
# MODEL SELECTION IS NOT CONFIGURED HERE.
#
# Laravel sends `text_llm`; app/services/models.py resolves it against
# app/services/llm_registry.json into a provider and a real model id. There is
# deliberately no LLM_PROVIDER, no *_MODEL and no MODEL_ALIASES - a model name
# in the environment is a model nobody can see from the dashboard that chose it.
#
# To add or change a model, edit app/services/llm_registry.json and restart.
# LLM_REGISTRY_PATH may point at a replacement registry FILE (a path, never a
# model name).
#LLM_REGISTRY_PATH=/etc/openclaw/llm_registry.json
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# RAG layer (app/rag/) - document ingestion and vector search
#
# Entirely optional. With RAG_DATABASE_URL unset, /api/rag/* answers 503 and
# every other endpoint behaves exactly as before.
# ---------------------------------------------------------------------------

# Postgres with pgvector available. DATABASE_URL is used as a fallback.
# Format: postgresql://user:password@host:5432/database
RAG_DATABASE_URL=
RAG_DB_SCHEMA=public
RAG_DB_POOL_MIN=1
RAG_DB_POOL_MAX=5

# -- embeddings -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
# auto (default) | http | local
#   http  - EMBEDDING_API_BASE points at an OpenAI-compatible /embeddings
#           endpoint (text-embeddings-inference, Infinity, vLLM, Ollama).
#           Nothing is loaded in this process.
#   local - sentence-transformers loads BGE-M3 here. Needs the extra install
#           and roughly 2 GB of RAM.
EMBEDDING_BACKEND=auto

# Point at the embedding server with ONE of these. URL wins if both are set.
#   EMBEDDING_API_BASE - an OpenAI-compatible base; "/embeddings" is appended.
#                        e.g. http://embeddings:8080/v1
#   EMBEDDING_API_URL  - the full endpoint, for a server with its own path.
#                        e.g. https://embeddings.example.com/embed
EMBEDDING_API_BASE=
EMBEDDING_API_URL=

# The request body shape. Response shapes are auto-detected; only the request
# has to be declared.
#   openai - {"model": "...", "input": ["a","b"]}   TEI, Infinity, vLLM, Ollama
#   texts  - {"texts": ["a","b"]}                   a service with its own shape
EMBEDDING_API_FORMAT=openai

# Which header carries the key. "Authorization" is sent as "Bearer <key>"; any
# other name (X-API-Key, …) is sent as the bare value.
EMBEDDING_API_KEY_HEADER=Authorization
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_S=120
EMBEDDING_BATCH_SIZE=32
# cpu | cuda | mps. Blank lets the library choose. Local backend only.
EMBEDDING_DEVICE=

# The width of the stored vector. It MUST equal what the model returns - the
# service checks it against a live embedding and refuses to ingest on a
# mismatch rather than writing rows Postgres will reject. 1024 is BGE-M3.
# Changing this needs a re-migration AND a re-embed of every document.
RAG_EMBEDDING_DIM=1024

# -- chunking ---------------------------------------------------------------
# Characters, not tokens. Overlap must be smaller than the size.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
# Fragments below this are folded into the previous chunk instead of stored.
RAG_MIN_CHUNK_SIZE=100

# -- retrieval --------------------------------------------------------------
RAG_TOP_K=5
RAG_MAX_TOP_K=50
# Below this similarity a chunk is not returned and `found` is false. Tuned for
# cosine, where similarity is 1 - distance. Raise it if search returns loosely
# related text; lower it if obvious matches are being missed.
RAG_SIMILARITY_THRESHOLD=0.70
# cosine (default, matches BGE-M3's normalised vectors) | l2 | inner_product.
# Changing it changes the pgvector operator AND the index opclass, so re-run
# the migration afterwards.
RAG_DISTANCE_METRIC=cosine
# Cap on what /api/rag/context returns, in characters.
RAG_CONTEXT_MAX_CHARS=6000

# -- uploads ----------------------------------------------------------------
RAG_MAX_UPLOAD_MB=25
# Where the original file is kept, so a document can be re-chunked without a
# re-upload. Blank = do not keep the bytes.
RAG_STORAGE_DIR=./storage/rag_documents
