# ---------------------------------------------------------------------------
# Universal RAG Service Configuration
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Write the log to a file as well as stdout. Blank = stdout only.
LOG_DIR=
LOG_FILE_NAME=rag-service.log
LOG_FILE_MAX_MB=20
LOG_FILE_KEEP=10

# Shared secret every caller must send. Header: Authorization: Bearer <value>
RAG_API_TOKEN=change-me-rag-token

# ---------------------------------------------------------------------------
# RAG layer - document ingestion and vector search
# ---------------------------------------------------------------------------

# Postgres with pgvector available.
# Format: postgresql://user:password@host:5432/database
RAG_DATABASE_URL=
RAG_DB_SCHEMA=public
RAG_DB_POOL_MIN=1
RAG_DB_POOL_MAX=5

# -- inference provider selection -------------------------------------------
# Options: local | cloudflare (defaults to local)
EMBEDDING_PROVIDER=local
RERANKER_PROVIDER=local

# -- cloudflare workers ai credentials --------------------------------------
# Required when EMBEDDING_PROVIDER=cloudflare or RERANKER_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
CLOUDFLARE_RERANKER_MODEL=@cf/baai/bge-reranker-base
CLOUDFLARE_TIMEOUT_S=30.0

# -- embeddings -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
# auto (default) | http | local
#   http  - EMBEDDING_API_BASE points at an OpenAI-compatible /embeddings
#           endpoint (text-embeddings-inference, Infinity, vLLM, Ollama).
#   local - sentence-transformers loads BGE-M3 here. Needs the extra install.
EMBEDDING_BACKEND=auto

# Point at the embedding server with ONE of these. URL wins if both are set.
#   EMBEDDING_API_BASE - an OpenAI-compatible base; "/embeddings" is appended.
#                        e.g. http://embeddings:8080/v1
#   EMBEDDING_API_URL  - the full endpoint, for a server with its own path.
#                        e.g. https://embeddings.example.com/embed
EMBEDDING_API_BASE=
EMBEDDING_API_URL=

# The request body shape. Response shapes are auto-detected; only the request has to be declared.
#   openai - {"model": "...", "input": ["a","b"]}
#   texts  - {"texts": ["a","b"]}
EMBEDDING_API_FORMAT=openai

# Which header carries the key. "Authorization" is sent as "Bearer <key>"; any other name is sent as the bare value.
EMBEDDING_API_KEY_HEADER=Authorization
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_S=120
EMBEDDING_BATCH_SIZE=32
# cpu | cuda | mps. Blank lets the library choose. Local backend only.
EMBEDDING_DEVICE=

# The width of the stored vector. It MUST equal what the model returns. 1024 is BGE-M3.
RAG_EMBEDDING_DIM=1024

# -- chunking ---------------------------------------------------------------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
# Fragments below this are folded into the previous chunk instead of stored.
RAG_MIN_CHUNK_SIZE=100

# -- retrieval --------------------------------------------------------------
RAG_TOP_K=5
RAG_MAX_TOP_K=50
# Below this similarity a chunk is not returned and `found` is false. Tuned for cosine.
RAG_SIMILARITY_THRESHOLD=0.70
# cosine (default) | l2 | inner_product.
RAG_DISTANCE_METRIC=cosine
# Cap on what /api/rag/context returns, in characters.
RAG_CONTEXT_MAX_CHARS=6000

# -- hybrid search settings -------------------------------------------------
RAG_VECTOR_CANDIDATES=20
RAG_KEYWORD_CANDIDATES=20
RAG_RRF_K=60

# -- reranker settings ------------------------------------------------------
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TOP_K=5
RAG_RERANK_MODEL=BAAI/bge-reranker-base

# -- uploads ----------------------------------------------------------------
RAG_MAX_UPLOAD_MB=25
# Where the original file is kept. Blank = do not keep the bytes.
RAG_STORAGE_DIR=./storage/rag_documents

# -- llm answer pipeline (/api/rag/ask) -------------------------------------
# auto | groq | gemini | openai | anthropic | ollama | mock
RAG_LLM_PROVIDER=auto
RAG_LLM_MODEL=
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=1024
RAG_MAX_HISTORY_TURNS=10
# Optional custom system prompt
RAG_DEFAULT_SYSTEM_PROMPT=

# Provider API Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# -- mongodb logging --------------------------------------------------------
# MongoDB connection URL. Blank disables MongoDB logging.
# Format: mongodb://user:password@host:27017/
MONGODB_URL=
MONGODB_DATABASE=universal_rag
MONGODB_COLLECTION=rag_logs

# -- WhatsApp Cloud API integration (/api/whatsapp) ------------------------
# Meta WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=universal-rag-test-2026
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_TENANT_ID=default
# Optional JSON mapping: '{"PHONE_NUMBER_ID": "TENANT_ID"}'
WHATSAPP_TENANT_MAPPING_JSON=


